<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hermes_mobile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hermes_mobile_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/hermes_mobile_brief_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/hermes_mobile_widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/hermes_mobile_brief_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="5"
        android:textColor="@color/hermes_mobile_widget_text2"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/hermes_mobile_brief_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hermes_mobile_widget_text2"
        android:textSize="11sp" />
</LinearLayout>
