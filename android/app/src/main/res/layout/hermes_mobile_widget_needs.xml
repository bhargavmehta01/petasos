<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hermes_mobile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hermes_mobile_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hermes_mobile_widget_needs_title"
        android:textColor="@color/hermes_mobile_widget_text2"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/hermes_mobile_needs_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hermes_mobile_widget_accent"
        android:textSize="34sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/hermes_mobile_needs_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/hermes_mobile_widget_text"
        android:textSize="12sp" />
</LinearLayout>
